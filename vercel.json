{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "studentnest": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm install && npm run build && npm install --prefix backend"
    },
    "backend": {
      "root": "backend",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "studentnest"
      }
    }
  ]
}
